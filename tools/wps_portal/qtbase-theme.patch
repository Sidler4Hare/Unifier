+static void appendNameFilters(const QString &entry,
+                              QXdgDesktopPortalFileDialog::FilterList &filters)
+{
+    // The KSO build can supply several Label (*.ext) groups in one entry.
+    static const QRegularExpression groups(QStringLiteral(R"(\(([^()]*)\))"));
+    static const QRegularExpression space(QStringLiteral(R"([\s;]+)"));
+    static const QRegularExpression glob(QStringLiteral(R"(^[^\s()/\\]*[?*][^\s()/\\]*$)"));
+    int start = 0;
+    auto matches = groups.globalMatch(entry);
+    while (matches.hasNext()) {
+        const auto match = matches.next();
+        const auto patterns = match.captured(1).split(space, QString::SkipEmptyParts);
+        QXdgDesktopPortalFileDialog::FilterConditionList conditions;
+        for (const auto &pattern : patterns) {
+            if (glob.match(pattern).hasMatch())
+                conditions << QXdgDesktopPortalFileDialog::FilterCondition{
+                    QXdgDesktopPortalFileDialog::GlobalPattern, pattern};
+        }
+        if (conditions.isEmpty() || conditions.size() != patterns.size())
+            continue;
+        const auto label = entry.mid(start, match.capturedStart() - start).trimmed();
+        if (!label.isEmpty()) {
+            QXdgDesktopPortalFileDialog::Filter filter;
+            filter.name = label;
+            filter.original = entry.mid(start, match.capturedEnd() - start).trimmed();
+            filter.filterConditions = conditions;
+            filters << filter;
+        }
+        start = match.capturedEnd();
+    }
+}
+
+static bool sameFilter(const QXdgDesktopPortalFileDialog::Filter &first,
+                       const QXdgDesktopPortalFileDialog::Filter &second)
+{
+    if (first.name != second.name || first.filterConditions.size() != second.filterConditions.size())
+        return false;
+    for (int i = 0; i < first.filterConditions.size(); ++i) {
+        const auto &a = first.filterConditions.at(i);
+        const auto &b = second.filterConditions.at(i);
+        if (a.type != b.type || a.pattern != b.pattern)
+            return false;
+    }
+    return true;
