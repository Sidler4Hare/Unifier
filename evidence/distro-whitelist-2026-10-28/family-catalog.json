{
  "schema_version": 1,
  "policy_version": 1,
  "mode": "whitelist",
  "families": {
    "debian": {
      "ids": [
        "debian",
        "ubuntu",
        "linuxmint",
        "pop",
        "elementary",
        "zorin"
      ],
      "package_driver": "apt",
      "package_format": "deb",
      "host_admitted": true,
      "reference_host": "debian"
    },
    "fedora": {
      "ids": [
        "fedora"
      ],
      "package_driver": "dnf",
      "package_format": "rpm",
      "host_admitted": true,
      "reference_host": "fedora"
    },
    "rhel": {
      "ids": [
        "rhel",
        "centos",
        "rocky",
        "almalinux"
      ],
      "package_driver": "dnf",
      "package_format": "rpm",
      "host_admitted": true,
      "reference_host": "rhel"
    },
    "arch": {
      "ids": [
        "arch",
        "endeavouros",
        "manjaro"
      ],
      "package_driver": "pacman",
      "package_format": "arch",
      "host_admitted": true,
      "reference_host": "arch"
    },
    "suse": {
      "ids": [
        "opensuse-leap",
        "opensuse-tumbleweed",
        "sles",
        "sled"
      ],
      "package_driver": "zypper",
      "package_format": "rpm",
      "host_admitted": true,
      "reference_host": "opensuse-tumbleweed"
    },
    "alpine": {
      "ids": [
        "alpine"
      ],
      "package_driver": "apk",
      "package_format": "apk",
      "host_admitted": false,
      "reason": "musl host integration needs a separate adapter"
    },
    "nixos": {
      "ids": [
        "nixos"
      ],
      "package_driver": "nix",
      "package_format": "nix",
      "host_admitted": false,
      "reason": "Nix store and generation integration need a separate adapter"
    },
    "void": {
      "ids": [
        "void"
      ],
      "package_driver": "xbps",
      "package_format": "xbps",
      "host_admitted": false,
      "reason": "XBPS, runit and libc variants need a separate adapter"
    },
    "gentoo": {
      "ids": [
        "gentoo"
      ],
      "package_driver": "portage",
      "package_format": "ebuild",
      "host_admitted": false,
      "reason": "source builds, profiles and init variants need a separate adapter"
    }
  },
  "container_targets": {
    "debian13": "debian",
    "fedora44": "fedora",
    "arch": "arch"
  },
  "atomic_variants_excluded": [
    "aeon",
    "atomic",
    "bootc",
    "budgie-atomic",
    "coreos",
    "cosmic-atomic",
    "iot",
    "kalpa",
    "kinoite",
    "micro",
    "microos",
    "onyx",
    "sericea",
    "silverblue",
    "sway-atomic",
    "xfce-atomic"
  ],
  "id_like_grants_admission": false,
  "validation_scope": "policy-only"
}
