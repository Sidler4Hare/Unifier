+            "project_uuid": (project or self.project)["project_uuid"],
+            "environment_binding": self.binding_of(environment_id),
+            "argv": ["/bin/echo", "hello from the host"],
+            "cwd": str(self.document.parent if project is None else project.get(
+                "default_save_root")),
