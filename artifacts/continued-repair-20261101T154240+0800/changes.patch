+            self.assertFalse(root.exists())
+            self.assertEqual(receipt.read_text(encoding="utf-8"), '{"passed": true}\n')
+            self.assertFalse(evidence_root.exists(),
+                             "an explicit external output needs no preserved run directory")
+
+
