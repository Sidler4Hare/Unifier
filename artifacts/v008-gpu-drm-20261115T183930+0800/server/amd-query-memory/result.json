        "-ec",
        "\nroot=$1\nisolated=$2\nshift 2\n[ \"$#\" -eq 36 ]\n[ \"$(id -u)\" -eq 0 ]\numask 077\n[ -d \"$root\" ] && [ ! -L \"$root\" ] && [ \"$(stat -c %u -- \"$root\")\" = 0 ] || exit 1\n[ ! -e \"$isolated\" ] && [ ! -L \"$isolated\" ] || exit 1\nverify() {\n    while [ \"$#\" -gt 0 ]; do\n        rel=$1\n        src=$root/$rel\n        [ -f \"$src\" ] && [ ! -L \"$src\" ] || return 1\n        before=$(stat -c '%d:%i:%f:%u:%h:%s:%y:%z' -- \"$src\")\n        [ \"$(stat -c '%u:%h:%s' -- \"$src\")\" = \"0:1:$2\" ]\n        got=$(head -c \"$(($2 + 1))\" -- \"$src\" | sha256sum)\n        [ \"${got%% *}\" = \"$3\" ]\n        [ ! -L \"$src\" ] && [ \"$(stat -c '%d:%i:%f:%u:%h:%s:%y:%z' -- \"$src\")\" = \"$before\" ] || return 1\n        shift 3\n    done\n}\nverify \"$@\"\nmkdir -- \"$isolated\"\nwhile [ \"$#\" -gt 0 ]; do\n    rel=$1\n    src=$root/$rel\n    dst=$isolated/$rel\n    mkdir -p -- \"${dst%/*}\"\n    before=$(stat -c '%d:%i:%f:%u:%s:%y' -- \"$src\")\n    ln -T -- \"$src\" \"$dst\"\n    [ ! -L \"$src\" ] && [ ! -L \"$dst\" ] || exit 1\n    [ \"$(stat -c '%d:%i:%f:%u:%s:%y' -- \"$src\")\" = \"$before\" ]\n    [ \"$(stat -c '%d:%i:%f:%u:%s:%y' -- \"$dst\")\" = \"$before\" ]\n    [ \"$(stat -c '%u:%h:%s' -- \"$dst\")\" = \"0:2:$2\" ]\n    got=$(head -c \"$(($2 + 1))\" -- \"$dst\" | sha256sum)\n    [ \"${got%% *}\" = \"$3\" ]\n    printf '%s %s %s\\n' \"$rel\" \"$2\" \"$3\"\n    shift 3\ndone\n",
