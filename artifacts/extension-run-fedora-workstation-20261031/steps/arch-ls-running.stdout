{
  "schema_version": 1,
  "target": "arch",
  "via": "runtime",
  "path": "/",
  "entries": [
    "bin",
    "boot",
    "dev",
    "etc",
    "home",
    "lib",
    "lib64",
    "mnt",
    "opt",
    "proc",
    "root",
    "run",
    "sbin",
    "srv",
    "sys",
    "tmp",
    "usr",
    "var"
  ]
}
